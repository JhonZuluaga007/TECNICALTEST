{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["dart"],
  "permissions": {
    "allow": [
      "Bash(fvm flutter analyze:*)",
      "Bash(fvm flutter test:*)",
      "Bash(fvm flutter pub get:*)",
      "Bash(fvm flutter pub outdated:*)",
      "Bash(fvm flutter --version)",
      "Bash(fvm flutter devices:*)",
      "Bash(fvm dart format:*)",
      "Bash(fvm dart analyze:*)",
      "Bash(fvm dart run build_runner:*)",
      "Bash(fvm dart fix --dry-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Read(./env/*.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-fvm.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-dart.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
